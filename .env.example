# ScamShield AI - Environment Configuration

# Database
DATABASE_URL=postgresql+asyncpg://scamshield:password@localhost:5432/scamshield
DATABASE_URL_SYNC=postgresql://scamshield:password@localhost:5432/scamshield

# Redis
REDIS_URL=redis://localhost:6379/0
REDIS_PASSWORD=

# Security
SECRET_KEY=your-secret-key-here-change-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
BCRYPT_ROUNDS=12

# JWT
JWT_ISSUER=scamshield-ai
JWT_AUDIENCE=scamshield-api

# ML/DL Models
MODEL_REGISTRY_PATH=./models
TEXT_MODEL_PATH=./models/text_detector/default
TRANSACTION_MODEL_PATH=./models/transaction_detector/default
DOCUMENT_MODEL_PATH=./models/document_detector/default

# HuggingFace
HUGGINGFACE_API_TOKEN=your-token-here
HF_CACHE_DIR=./data/huggingface_cache

# OpenAI / GenAI
OPENAI_API_KEY=your-openai-key-here
OPENAI_MODEL=gpt-3.5-turbo
OPENAI_MAX_TOKENS=1000

# Anthropic / Claude
ANTHROPIC_API_KEY=your-anthropic-key-here
CLAUDE_MODEL=claude-3-haiku-20240307

# Replicate
REPLICATE_API_TOKEN=your-replicate-token-here

# Vector Stores (Optional)
CHROMA_PATH=./data/chroma_db
PINECONE_API_KEY=your-pinecone-key
PINECONE_ENVIRONMENT=us-east1-aws
QDRANT_URL=http://localhost:6333
WEAVIATE_URL=http://localhost:8080

# Observability
PROMETHEUS_ENABLED=true
PROMETHEUS_PORT=9090
OTEL_ENABLED=true
OTEL_SERVICE_NAME=scamshield-ai
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317

# MLOps
MLFLOW_TRACKING_URI=http://localhost:5000
MLFLOW_EXPERIMENT_NAME=scamshield_training
MLFLOW_ARTIFACT_PATH=./artifacts/mlflow
DRIFT_THRESHOLD=0.5
CONCEPT_DRIFT_THRESHOLD=0.1
MULTIVARIATE_DRIFT_THRESHOLD=0.1

# Rate Limiting
RATE_LIMIT_PER_MINUTE=60
RATE_LIMIT_PER_HOUR=1000

# Feature Flags
ENABLE_TEXT_DETECTION=true
ENABLE_TRANSACTION_DETECTION=true
ENABLE_DOCUMENT_DETECTION=true
ENABLE_MULTI_MODAL=true
ENABLE_ALERTS=true
ENABLE_ANALYTICS=true

# Frontend
STREAMLIT_SERVER_PORT=8501
STREAMLIT_SERVER_ADDRESS=0.0.0.0

# Logging
LOG_LEVEL=INFO
LOG_FORMAT=json
LOG_FILE=./logs/scamshield.log

# CORS
CORS_ORIGINS=["http://localhost:3000","http://localhost:8501","http://localhost:8000"]